+/-! ### The next known primary pseudoperfect number: `47058`
+
+Unlike `6 → 42 → 1806`, the next primary pseudoperfect number does **not**
+come from `succ_prime_extension`: `1807 = 13 · 139` is composite, so `1806`
+cannot be extended by `m + 1`. Instead, `47058 = 2 · 3 · 11 · 23 · 31` is
+built independently from `6` by successively adjoining the coprime primes
+`11`, `23`, `31`, each verified through the general coprime-product
+extension lemma. -/
+
+/-- Witness for `66 = 6 · 11` obtained by adjoining the coprime prime `11`
+to `{2, 3}`. -/
+theorem sixtySix_witness :
+    PrimeReciprocalWitness 66 ({2, 3, 11} : Finset ℕ) := by
+  have hP : insert 11 ({2, 3} : Finset ℕ) = ({2, 3, 11} : Finset ℕ) := by
+    ext x
+    simp [or_assoc, or_comm]
+  have hsum : (∑ p ∈ ({2, 3} : Finset ℕ), (1 : ℚ) / p) + 1 / 11
+                = 1 - 1 / ((6 * 11 : ℕ) : ℚ) := by
+    simp
+    norm_num
+  have hndvd : ¬ (11 : ℕ) ∣ 6 := by decide
+  have hwit := extend_witness_via_coprime_product
+    (m := 6) (d := 11) (P := ({2, 3} : Finset ℕ))
+    (by omega) (fun p hp => by
+      have : p = 2 ∨ p = 3 := by simpa [or_comm] using hp
+      rcases this with rfl | rfl
+      · exact (by decide : Nat.Prime 2)
+      · exact (by decide : Nat.Prime 3))
+    (by decide) (by decide : Nat.Prime 11) hndvd hsum
+  simpa [hP] using hwit
+
+/-- Witness for `1518 = 66 · 23` obtained by adjoining the coprime prime `23`
+to `{2, 3, 11}`. -/
+theorem fifteenEighteen_witness :
+    PrimeReciprocalWitness 1518 ({2, 3, 11, 23} : Finset ℕ) := by
+  have hP : insert 23 ({2, 3, 11} : Finset ℕ) = ({2, 3, 11, 23} : Finset ℕ) := by
+    ext x
+    simp [or_assoc, or_comm]
+  have hsum : (∑ p ∈ ({2, 3, 11} : Finset ℕ), (1 : ℚ) / p) + 1 / 23
+                = 1 - 1 / ((66 * 23 : ℕ) : ℚ) := by
+    simp
+    norm_num
+  have hndvd : ¬ (23 : ℕ) ∣ 66 := by decide
+  rcases sixtySix_witness with ⟨hprimes66, hprod66, _⟩
+  have hwit := extend_witness_via_coprime_product
+    (m := 66) (d := 23) (P := ({2, 3, 11} : Finset ℕ))
+    (by omega) hprimes66 hprod66
+    (by decide : Nat.Prime 23) hndvd hsum
+  simpa [hP] using hwit
+
+/-- Witness for `47058 = 1518 · 31` obtained by adjoining the coprime prime
+`31` to `{2, 3, 11, 23}`. -/
+theorem fortySevenThousandFiftyEight_witness :
+    PrimeReciprocalWitness 47058 ({2, 3, 11, 23, 31} : Finset ℕ) := by
+  have hP : insert 31 ({2, 3, 11, 23} : Finset ℕ)
+              = ({2, 3, 11, 23, 31} : Finset ℕ) := by
+    ext x
+    simp [or_assoc, or_comm]
+  have hsum : (∑ p ∈ ({2, 3, 11, 23} : Finset ℕ), (1 : ℚ) / p) + 1 / 31
+                = 1 - 1 / ((1518 * 31 : ℕ) : ℚ) := by
+    simp
+    norm_num
+  have hndvd : ¬ (31 : ℕ) ∣ 1518 := by decide
+  rcases fifteenEighteen_witness with ⟨hprimes1518, hprod1518, _⟩
+  have hwit := extend_witness_via_coprime_product
+    (m := 1518) (d := 31) (P := ({2, 3, 11, 23} : Finset ℕ))
+    (by omega) hprimes1518 hprod1518
+    (by decide : Nat.Prime 31) hndvd hsum
+  simpa [hP] using hwit
+
+/-- `47058` is primary pseudoperfect, with prime witness `{2, 3, 11, 23, 31}`. -/
+theorem isPrimaryPseudoperfect_47058 : IsPrimaryPseudoperfect 47058 :=
+  ⟨by omega, {2, 3, 11, 23, 31}, fortySevenThousandFiftyEight_witness⟩
+
+/-- `47058` is pseudoperfect. -/
+theorem pseudoperfect_47058 : WeirdNumbers.Pseudoperfect 47058 :=
+  primaryPseudoperfect_pseudoperfect isPrimaryPseudoperfect_47058 (by omega)
+
 end PrimaryPseudoperfect
